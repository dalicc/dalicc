                [ a odrl:Duty ;
                    odrl:action dalicc:rename ],
                [ a odrl:Duty ;
                    odrl:action dalicc:originalVersionOffer ] ],
        [ a odrl:Permission ;
            odrl:action odrl:derive ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Notice ;
                    dalicc:evidence "The Recipient must attach a copy of this Agreement to the Licensed Program." ],
                [ a odrl:Duty ;
                    odrl:action cc:SourceCode ],
                [ a odrl:Duty ;
                    odrl:action cc:ShareAlike ],
                [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ],
                [ a odrl:Duty ;
                    odrl:action dalicc:rename ],
                [ a odrl:Duty ;
                    odrl:action dalicc:originalVersionOffer ] ],
        [ a odrl:Permission ;
            odrl:action cc:DerivativeWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:chargeDistributionFee ] ;
    odrl:prohibition [ a odrl:Prohibition ;
            odrl:action dalicc:ChangeLicense ],
        [ a odrl:Prohibition ;
            odrl:action dalicc:promote ;
            dalicc:evidence "In no sense is this Agreement intended to transfer ... any right relating to any trademark, trade name, or service mark to the Recipient" ] ;
