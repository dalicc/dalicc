                    odrl:action cc:Notice ],
                [ a odrl:Duty ;
                    odrl:action cc:SourceCode ],
                [ a odrl:Duty ;
                    odrl:action cc:ShareAlike ] ],
        [ a odrl:Permission ;
            odrl:action odrl:modify ;
