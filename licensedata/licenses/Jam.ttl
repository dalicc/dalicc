# Title: The machine-readable representation of "Jam License"@en in the DALICC license library
# Author: DALICC
# Source: https://dalicc.net/licenselibrary/Jam
# Licensed under: Attribution 4.0 International (CC BY 4.0) 

@prefix bpicounty: <http://www.bpiresearch.com/BPMO/2004/03/03/cdl/Countries#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix scho: <http://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dalicclib:Jam a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    spdx:licenseId "Jam" ;
    cc:jurisdiction dalicc:worldwide ;
    cc:legalcode <https://www.boost.org/doc/libs/1_35_0/doc/html/jam.html> ;
    dalicc:WarrantyDisclaimer "ALL WARRANTIES ARE HEREBY DISCLAIMED." ;
    dalicc:validityType dalicc:perpetual ;
    dalicc:reviewStatus dalicc:Created ;
    dalicc:reviewedOn "2026-09-15"^^xsd:date ;
    dalicc:versionHistory <https://dalicc.net/licenselibrary/Jam/versions> ;
    dct:alternative "Jam",
        "Jam License" ;
    dct:hasVersion "2" ;
    dct:modified "2026-09-24"^^xsd:date ;
    dct:source <https://spdx.org/licenses/Jam.html> ;
    dct:title "Jam License"@en ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:reproduce ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ] ],
        [ a odrl:Permission ;
            odrl:action odrl:modify ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:derive ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:display ],
        [ a odrl:Permission ;
            odrl:action odrl:present ],
        [ a odrl:Permission ;
            odrl:action cc:CommercialUse ],
        [ a odrl:Permission ;
            odrl:action cc:DerivativeWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:chargeDistributionFee ],
        [ a odrl:Permission ;
            odrl:action dalicc:ChangeLicense ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action dalicc:compliantLicense ;
                    dalicc:statementOrigin dalicc:FromConvention ;
                    dalicc:convention "family rule 15: Permissive records permit relicensing" ] ;
            dalicc:statementOrigin dalicc:FromConvention ;
            dalicc:convention "family rule 15: Permissive records permit relicensing" ] ;
    odrl:target [ a odrl:AssetCollection ;
            dct:type dcmitype:Software ] .
