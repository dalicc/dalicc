dalicclib:QPublicLicenseVersion10 a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    spdx:licenseId "QPL-1.0" ;
    cc:attributionName "Trolltech AS" ;
    cc:jurisdiction dalicc:worldwide ;
