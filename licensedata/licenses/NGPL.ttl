@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dalicclib:NGPL a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    spdx:licenseId "NGPL" ;
    cc:jurisdiction dalicc:worldwide ;
    cc:legalcode <https://opensource.org/license/NGPL> ;
    dalicc:additionalClauses "b) cause the whole of any work that you distribute or publish, that in whole or in part contains or is a derivative of NetHack or any part thereof, to be licensed at no charge to all third parties on terms identical to those contained in this License Agreement (except that you may choose to grant more extensive warranty protection to some or all third parties, at your option)",
        "b) accompany it with full information as to how to obtain the complete machine-readable source code from an appropriate archive site. (This alternative is allowed only for noncommercial distribution.)",
        "You may not copy, sublicense, distribute or transfer NetHack except as expressly provided under this License Agreement. Any attempt otherwise to copy, sublicense, distribute or transfer NetHack is void and your rights to use the program under this License agreement shall be automatically terminated. However, parties who have received computer software programs from you with this License Agreement will not have their licenses terminated so long as such parties remain in full compliance." ;
    dalicc:validityType dalicc:perpetual ;
    dalicc:terminatesOnBreach true ;
    dalicc:reviewStatus dalicc:Created ;
    dalicc:reviewedOn "2026-09-15"^^xsd:date ;
    dalicc:versionHistory <https://dalicc.net/licenselibrary/NGPL/versions> ;
    dct:alternative "NGPL",
        "Nethack General Public License" ;
    dct:hasVersion "2" ;
    dct:modified "2026-09-24"^^xsd:date ;
    dct:source <https://opensource.org/license/NGPL> ;
    dct:title "Nethack General Public License"@en ;
    odrl:duty [ a odrl:Duty ;
            odrl:action cc:ShareAlike ;
            dalicc:evidence "cause the whole of any work that you distribute or publish, that in whole or in part contains or is a derivative of NetHack or any part thereof, to be licensed at no charge to all third parties on terms identical to those contained in this License Agreement (except that you may choose to grant more extensive warranty protection to some or all third parties, at your option)" ] ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:reproduce ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ],
                [ a odrl:Duty ;
                    odrl:action cc:SourceCode ],
                [ a odrl:Duty ;
                    odrl:action dalicc:noWarrantyNotice ;
                    dalicc:evidence "You may copy and distribute verbatim copies of NetHack source code as you receive it, in any medium, provided that you keep intact the notices on all files that refer to copyrights, to this License Agreement, and to the absence of any warranty; and give any other recipients of the NetHack program a copy of this License Agreement along with the program." ] ],
        [ a odrl:Permission ;
            odrl:action odrl:modify ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ],
                [ a odrl:Duty ;
                    odrl:action cc:SourceCode ],
                [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ],
                [ a odrl:Duty ;
                    odrl:action dalicc:noWarrantyNotice ;
                    dalicc:evidence "You may copy and distribute verbatim copies of NetHack source code as you receive it, in any medium, provided that you keep intact the notices on all files that refer to copyrights, to this License Agreement, and to the absence of any warranty; and give any other recipients of the NetHack program a copy of this License Agreement along with the program." ] ],
        [ a odrl:Permission ;
            odrl:action odrl:derive ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ],
                [ a odrl:Duty ;
                    odrl:action cc:SourceCode ],
                [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ],
                [ a odrl:Duty ;
                    odrl:action dalicc:noWarrantyNotice ;
                    dalicc:evidence "You may copy and distribute verbatim copies of NetHack source code as you receive it, in any medium, provided that you keep intact the notices on all files that refer to copyrights, to this License Agreement, and to the absence of any warranty; and give any other recipients of the NetHack program a copy of this License Agreement along with the program." ] ],
        [ a odrl:Permission ;
            odrl:action odrl:display ],
        [ a odrl:Permission ;
            odrl:action odrl:present ],
        [ a odrl:Permission ;
            odrl:action cc:CommercialUse ],
        [ a odrl:Permission ;
            odrl:action cc:DerivativeWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:chargeDistributionFee ;
            dalicc:evidence "You may charge a distribution fee for the physical act of transferring a copy, and you may at your option offer warranty protection in exchange for a fee." ] ;
    odrl:prohibition [ a odrl:Prohibition ;
            odrl:action dalicc:sublicense ;
            dalicc:evidence "You may not copy, sublicense, distribute or transfer NetHack except as expressly provided under this License Agreement." ],
        [ a odrl:Prohibition ;
            odrl:action dalicc:ChangeLicense ] ;
    odrl:target [ a odrl:AssetCollection ;
            dct:type dcmitype:Software ] .
