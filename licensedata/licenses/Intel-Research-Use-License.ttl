    dct:title "Intel Research Use License Agreement"@en ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:reproduce ;
            dalicc:evidence "Intel grants to You, a limited, non-transferable, non-sublicensable, non-exclusive, worldwide, royalty-free, license under Intel’s copyrights in the Material, to use, reproduce, display, and distribute the Material solely for research purposes." ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ],
        [ a odrl:Permission ;
            odrl:action odrl:display ] ;
    odrl:prohibition [ a odrl:Prohibition ;
            odrl:action cc:CommercialUse ],
        [ a odrl:Prohibition ;
