            odrl:action cc:DerivativeWorks ],
        [ a odrl:Prohibition ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Prohibition ;
            odrl:action dalicc:ChangeLicense ],
        [ a odrl:Prohibition ;
            odrl:action dalicc:sublicense ],
        [ a odrl:Prohibition ;
            odrl:action dalicc:exemptedMaterial ] ;
