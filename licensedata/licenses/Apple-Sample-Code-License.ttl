# Title: The machine-readable representation of "Apple Sample Code License"@en in the DALICC license library
# Author: DALICC
# Source: https://dalicc.net/licenselibrary/Apple-Sample-Code-License
# Licensed under: Attribution 4.0 International (CC BY 4.0) 

@prefix bpicounty: <http://www.bpiresearch.com/BPMO/2004/03/03/cdl/Countries#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix scho: <http://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dalicclib:Apple-Sample-Code-License a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    cc:jurisdiction dalicc:worldwide ;
    cc:legalcode <https://scancode-licensedb.aboutcode.org/apple-sscl.LICENSE> ;
    dalicc:WarrantyDisclaimer "This Apple sample source code has been provided \"AS IS\" and the responsibility for its operation is yours." ;
    dalicc:additionalClauses "You may incorporate this Apple sample source code into your program(s) without restriction.",
        "You are not permitted to redistribute this Apple sample source code as \"Apple sample source code\" after having made changes.",
        "If you're going to re-distribute the source, we require that you make it clear in the source that the code was descended from Apple sample source code, but that you've made changes." ;
    dalicc:validityType dalicc:perpetual ;
    dalicc:reviewStatus dalicc:Created ;
    dalicc:reviewedOn "2026-09-22"^^xsd:date ;
    dalicc:versionHistory <https://dalicc.net/licenselibrary/Apple-Sample-Code-License/versions> ;
    dct:alternative "Apple Sample Source Code License",
        "Apple-Sample-Code-License",
        "apple-ascl",
        "apple-sscl" ;
    dct:hasVersion "1" ;
    dct:modified "2026-09-22"^^xsd:date ;
    dct:publisher "Apple Inc." ;
    dct:source <https://developer.apple.com/support/downloads/terms/apple-sample-code/Apple-Sample-Code-License.pdf> ;
    dct:title "Apple Sample Code License"@en ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:reproduce ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ],
                [ a odrl:Duty ;
                    odrl:action dalicc:rename ] ],
        [ a odrl:Permission ;
            odrl:action odrl:modify ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ],
                [ a odrl:Duty ;
                    odrl:action dalicc:rename ] ],
        [ a odrl:Permission ;
            odrl:action odrl:derive ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ],
                [ a odrl:Duty ;
                    odrl:action dalicc:rename ] ],
        [ a odrl:Permission ;
            odrl:action cc:DerivativeWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Permission ;
            odrl:action cc:CommercialUse ],
        [ a odrl:Permission ;
            odrl:action dalicc:ChangeLicense ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action dalicc:compliantLicense ] ] ;
    odrl:target [ a odrl:AssetCollection ;
            dct:type dcmitype:Software ] .
