# Title: The machine-readable representation of "The zlib libpng License" in the DALICC license library
# Author: DALICC
# Source: https://dalicc.net/licenselibrary/TheZlibLibpngLicense
# Licensed under: Attribution 4.0 International (CC BY 4.0) 

@prefix bpicounty: <http://www.bpiresearch.com/BPMO/2004/03/03/cdl/Countries#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix scho: <http://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dalicclib:TheZlibLibpngLicense a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    spdx:licenseId "Zlib" ;
    cc:jurisdiction dalicc:worldwide ;
    cc:legalcode osl:Zlib ;
    dalicc:LiabilityLimitation "In no event will the authors be held liable for any damages arising from the use of this software." ;
    dalicc:WarrantyDisclaimer "This software is provided ‘as-is’, without any express or implied warranty." ;
    dalicc:validityType dalicc:perpetual ;
    dalicc:reviewStatus dalicc:Reviewed ;
    dalicc:reviewedOn "2026-09-15"^^xsd:date ;
    dalicc:versionHistory <https://dalicc.net/licenselibrary/TheZlibLibpngLicense/versions> ;
    dct:alternative "The Zlib/Libpng License",
        "ZLIB" ;
    dct:hasVersion "2" ;
    dct:modified "2026-09-24"^^xsd:date ;
    dct:source osl:Zlib ;
    dct:title "The zlib libpng License" ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:display ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:modify ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Notice ],
                [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ;
                    dalicc:evidence "Altered source versions must be plainly marked as such, and must not be misrepresented as being the original software." ],
                [ a odrl:Duty ;
                    odrl:action dalicc:rename ] ],
        [ a odrl:Permission ;
            odrl:action odrl:derive ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Notice ],
                [ a odrl:Duty ;
                    odrl:action dalicc:modificationNotice ;
                    dalicc:evidence "Altered source versions must be plainly marked as such, and must not be misrepresented as being the original software." ],
                [ a odrl:Duty ;
                    odrl:action dalicc:rename ] ],
        [ a odrl:Permission ;
            odrl:action odrl:present ],
        [ a odrl:Permission ;
            odrl:action odrl:reproduce ],
        [ a odrl:Permission ;
            odrl:action cc:CommercialUse ],
        [ a odrl:Permission ;
            odrl:action cc:DerivativeWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:chargeDistributionFee ],
        [ a odrl:Permission ;
            odrl:action dalicc:ChangeLicense ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action dalicc:compliantLicense ;
                    dalicc:statementOrigin dalicc:FromConvention ;
                    dalicc:convention "family rule 15: Permissive records permit relicensing" ] ;
            dalicc:statementOrigin dalicc:FromConvention ;
            dalicc:convention "family rule 15: Permissive records permit relicensing" ] ;
    odrl:target [ a odrl:AssetCollection ;
            dct:type dcmitype:Software ] .
