dalicclib:CDLA-Permissive-2.0 a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    spdx:licenseId "CDLA-Permissive-2.0" ;
    cc:jurisdiction dalicc:worldwide ;
