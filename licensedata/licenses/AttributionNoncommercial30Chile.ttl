    dct:source <https://creativecommons.org/licenses/by-nc/3.0/cl/> ;
    dct:title "Creative Commons Attribution-NonCommercial 3.0 Chile"@en ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:display ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ;
