# NLOD-2.0
dalicclib:NLOD-2.0 a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    spdx:licenseId "NLOD-2.0" ;
    cc:attributionName "Norwegian Ministry of Local Government and Modernisation" ;
