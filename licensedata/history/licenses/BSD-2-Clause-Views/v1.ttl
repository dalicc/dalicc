@prefix bpicounty: <http://www.bpiresearch.com/BPMO/2004/03/03/cdl/Countries#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix scho: <http://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dalicclib:BSD-2-Clause-Views a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    spdx:licenseId "BSD-2-Clause-Views" ;
    cc:jurisdiction dalicc:worldwide ;
    cc:legalcode <https://spdx.org/licenses/BSD-2-Clause-Views.html> ;
    dalicc:LiabilityLimitation "IN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE." ;
    dalicc:WarrantyDisclaimer "THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED." ;
    dalicc:additionalClauses "The views and conclusions contained in the software and documentation are those of the authors and should not be interpreted as representing official policies, either expressed or implied, of the copyright holders or contributors." ;
    dalicc:validityType dalicc:perpetual ;
    dalicc:reviewStatus dalicc:Created ;
    dalicc:reviewedOn "2026-09-22"^^xsd:date ;
    dalicc:versionHistory <https://dalicc.net/licenselibrary/BSD-2-Clause-Views/versions> ;
    dct:alternative "BSD 2-Clause with views sentence",
        "BSD-2-Clause-FreeBSD",
        "BSD-2-Clause-Views",
        "FreeBSD License" ;
    dct:hasVersion "1" ;
    dct:modified "2026-09-22"^^xsd:date ;
    dct:source <https://spdx.org/licenses/BSD-2-Clause-Views.html> ;
    dct:title "BSD 2-Clause with views sentence"@en ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:reproduce ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:modify ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:derive ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:display ],
        [ a odrl:Permission ;
            odrl:action odrl:present ],
        [ a odrl:Permission ;
            odrl:action cc:CommercialUse ],
        [ a odrl:Permission ;
            odrl:action cc:DerivativeWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:chargeDistributionFee ],
        [ a odrl:Permission ;
            odrl:action dalicc:ChangeLicense ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action dalicc:compliantLicense ] ] ;
    odrl:target [ a odrl:AssetCollection ;
            dct:type dcmitype:Software ] .
