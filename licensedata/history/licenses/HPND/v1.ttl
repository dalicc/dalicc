@prefix bpicounty: <http://www.bpiresearch.com/BPMO/2004/03/03/cdl/Countries#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix scho: <http://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dalicclib:HPND a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    spdx:licenseId "HPND" ;
    cc:jurisdiction dalicc:worldwide ;
    cc:legalcode <https://opensource.org/license/HPND> ;
    dalicc:LiabilityLimitation "IN NO EVENT SHALL <copyright holder> BE LIABLE FOR ANY SPECIAL, INDIRECT OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE." ;
    dalicc:WarrantyDisclaimer "<copyright holder> makes no representations about the suitability of this software for any purpose. It is provided \"as is\" without express or implied warranty. <copyright holder> DISCLAIMS ALL WARRANTIES WITH REGARD TO THIS SOFTWARE, INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS,." ;
    dalicc:validityType dalicc:perpetual ;
    dalicc:reviewStatus dalicc:Created ;
    dalicc:reviewedOn "2026-09-15"^^xsd:date ;
    dalicc:versionHistory <https://dalicc.net/licenselibrary/HPND/versions> ;
    dct:alternative "HPND",
        "Historical Permission Notice and Disclaimer" ;
    dct:hasVersion "1" ;
    dct:modified "2026-09-15"^^xsd:date ;
    dct:source <https://spdx.org/licenses/HPND.html> ;
    dct:title "Historical Permission Notice and Disclaimer"@en ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:reproduce ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:modify ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:derive ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:display ],
        [ a odrl:Permission ;
            odrl:action odrl:present ],
        [ a odrl:Permission ;
            odrl:action cc:CommercialUse ],
        [ a odrl:Permission ;
            odrl:action cc:DerivativeWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:chargeDistributionFee ],
        [ a odrl:Permission ;
            odrl:action dalicc:ChangeLicense ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action dalicc:compliantLicense ] ] ;
    odrl:prohibition [ a odrl:Prohibition ;
            odrl:action dalicc:promote ] ;
    odrl:target [ a odrl:AssetCollection ;
            dct:type dcmitype:Software ] .
