# Title: The machine-readable representation of "The MirOS Licence"@en in the DALICC license library
# Author: DALICC
# Source: https://dalicc.net/licenselibrary/MirOS
# Licensed under: Attribution 4.0 International (CC BY 4.0) 

@prefix bpicounty: <http://www.bpiresearch.com/BPMO/2004/03/03/cdl/Countries#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix scho: <http://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dalicclib:MirOS a odrl:Set ;
    cc:license dalicclib:CC-BY-4.0 ;
    spdx:licenseId "MirOS" ;
    cc:jurisdiction dalicc:worldwide ;
    cc:legalcode <https://opensource.org/license/MirOS> ;
    dalicc:LiabilityLimitation "In no event may a licensor, author or contributor be held liable for indirect, direct, other damage, loss, or other issues arising in any way out of dealing in the work, even if advised of the possibility of such damage or existence of a defect, except proven that it results out of said person's immediate fault when using the work as intended." ;
    dalicc:WarrantyDisclaimer "This work is provided \"AS IS\" and WITHOUT WARRANTY of any kind, to the utmost extent permitted by applicable law, neither express nor implied; without malicious intent or gross negligence." ;
    dalicc:validityType dalicc:perpetual ;
    dalicc:reviewStatus dalicc:Created ;
    dalicc:reviewedOn "2026-09-15"^^xsd:date ;
    dalicc:versionHistory <https://dalicc.net/licenselibrary/MirOS/versions> ;
    dct:alternative "MirOS",
        "The MirOS Licence" ;
    dct:hasVersion "1" ;
    dct:modified "2026-09-15"^^xsd:date ;
    dct:source <https://spdx.org/licenses/MirOS.html> ;
    dct:title "The MirOS Licence"@en ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:reproduce ],
        [ a odrl:Permission ;
            odrl:action odrl:distribute ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:modify ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:derive ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action cc:Attribution ],
                [ a odrl:Duty ;
                    odrl:action cc:Notice ] ],
        [ a odrl:Permission ;
            odrl:action odrl:display ],
        [ a odrl:Permission ;
            odrl:action odrl:present ],
        [ a odrl:Permission ;
            odrl:action dalicc:sublicense ],
        [ a odrl:Permission ;
            odrl:action cc:CommercialUse ],
        [ a odrl:Permission ;
            odrl:action cc:DerivativeWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:ModifiedWorks ],
        [ a odrl:Permission ;
            odrl:action dalicc:chargeDistributionFee ],
        [ a odrl:Permission ;
            odrl:action dalicc:ChangeLicense ;
            odrl:duty [ a odrl:Duty ;
                    odrl:action dalicc:compliantLicense ] ] ;
    odrl:target [ a odrl:AssetCollection ;
            dct:type dcmitype:Software ] .
