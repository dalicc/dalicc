@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns3: <https://www.statcan.gc.ca/eng/reference/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix ns6: <http://purl.org/dc/dcmitype/> .
@prefix ll: <https://dalicc.net/license-library/> .
@prefix du: <https://dalicc.net/dalicc-user/> .
@prefix dg: <https://dalicc.net/dependency-graph/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

cc:Notice odrl:includedIn odrl:use .
cc:ShareAlike odrl:implies cc:SourceCode .
cc:SourceCode odrl:includedIn odrl:use .
dalicc:promote odrl:includedIn odrl:use .
dalicc:publish odrl:includedIn dalicc:promote .
dalicc:publish odrl:includedIn odrl:use .
dalicc:royaltyFree odrl:implies dalicc:perpetual .
dalicc:sublicense owl:sameAs odrl:shareAlike .
odrl:copy owl:sameAs odrl:extract .
odrl:copy odrl:includedIn odrl:use .
odrl:display odrl:includedIn odrl:present .
odrl:display odrl:includedIn odrl:use .
odrl:extract odrl:includedIn odrl:use .
odrl:extract odrl:includedIn odrl:reproduce .
odrl:extract odrl:implies cc:SourceCode .
odrl:present owl:sameAs dalicc:publish .
odrl:present odrl:includedIn dalicc:promote .
odrl:present odrl:includedIn odrl:use .
odrl:reproduce owl:sameAs odrl:copy .
odrl:reproduce odrl:includedIn odrl:copy .
odrl:shareAlike owl:sameAs cc:ShareAlike .
