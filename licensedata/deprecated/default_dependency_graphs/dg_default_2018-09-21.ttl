@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns3: <https://www.statcan.gc.ca/eng/reference/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix ns6: <http://purl.org/dc/dcmitype/> .
@prefix ll: <https://dalicc.net/license-library/> .
@prefix du: <https://dalicc.net/dalicc-user/> .
@prefix dg: <https://dalicc.net/dependency-graph/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

cc:Attribution odrl:implies odrl:distribute .
cc:Attribution odrl:includedIn odrl:use .
cc:Attribution odrl:implies odrl:distribute .
cc:CommercialUse odrl:includedIn odrl:use .
cc:Notice odrl:implies odrl:distribute .
cc:Notice odrl:includedIn odrl:use .
cc:Notice odrl:implies odrl:distribute .
cc:ShareAlike odrl:includedIn odrl:use .
cc:ShareAlike dalicc:contradicts odrl:grantUse .
cc:SourceCode odrl:implies odrl:distribute .
cc:SourceCode odrl:includedIn odrl:use .
cc:SourceCode odrl:implies odrl:modify .
cc:SourceCode odrl:includedIn odrl:use .
dalicc:addLimitation odrl:includedIn odrl:use .
dalicc:addStatement odrl:includedIn odrl:use .
dalicc:chargeDistributionFee odrl:includedIn odrl:use .
dalicc:chargeDistributionFee odrl:implies odrl:distribute .
dalicc:modificationNotice odrl:implies odrl:modify .
dalicc:modificationNotice odrl:includedIn odrl:use .
dalicc:modificationNotice odrl:implies odrl:distribute .
dalicc:noWarrantyNotice odrl:includedIn odrl:use .
dalicc:promote odrl:implies cc:CommercialUse .
dalicc:promote odrl:includedIn odrl:use .
dalicc:rename odrl:implies odrl:modify .
dalicc:rename odrl:includedIn odrl:use .
dalicc:rename odrl:implies odrl:distribute .
dc:source odrl:implies odrl:distribute .
dc:source odrl:includedIn odrl:use .
odrl:display odrl:implies odrl:distribute .
odrl:display odrl:includedIn odrl:display .
odrl:distribute odrl:includedIn odrl:use .
odrl:grantUse dalicc:contradicts cc:ShareAlike .
odrl:grantUse odrl:includedIn odrl:use .
odrl:modify odrl:includedIn odrl:use .
odrl:play odrl:includedIn odrl:use .
odrl:present odrl:implies odrl:distribute .
odrl:present odrl:includedIn odrl:use .
odrl:reproduce odrl:includedIn odrl:use .
odrl:reproduce owl:sameAs cc:Reproduction .
