	dalicc:WarrantyDisclaimer	"\u0645\u0627 \u0644\u0645 \u064A\u062A\u0645 \u0627\u0644\u0627\u062A\u0641\u0627\u0642 \u0627\u0644\u0645\u062A\u0628\u0627\u062F\u0644 \u062E\u0637\u064A\u0627 \u0628\u064A\u0646 \u0627\u0644\u0623\u0637\u0631\u0627\u0641 \u0648\u0625\u0644\u0649 \u0627\u0644\u0645\u062F\u0649 \u0627\u0644\u0630\u064A \u064A\u0633\u0645\u062D \u0628\u0647 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u060C \u064A\u0642\u062F\u0645 \u0627\u0644\u0645\u064F\u0631\u064E\u062E\u0650\u0651\u0635 \u0627\u0644\u0645\u0635\u0646\u0641 \u0643\u0645\u0627 \u0647\u0648 \u0648\u0644\u0627 \u064A\u0642\u062F\u0645 \u0623\u064A \u0636\u0645\u0627\u0646\u0627\u062A \u0645\u0646 \u0623\u064A \u0646\u0648\u0639 \u0633\u0648\u0627\u0621 \u0643\u0627\u0646\u062A \u0635\u0631\u064A\u062D\u0629 \u0623\u0648 \u0636\u0645\u0646\u064A\u0629 \u0623\u0648 \u0642\u0627\u0646\u0648\u0646\u064A\u0629 \u0623\u0648 \u063A\u064A\u0631 \u0630\u0644\u0643\u060C \u0628\u0645\u0627 \u0641\u064A \u0630\u0644\u0643 \u0639\u0644\u0649 \u0633\u0628\u064A\u0644 \u0627\u0644\u0645\u062B\u0627\u0644 \u0644\u0627 \u0627\u0644\u062D\u0635\u0631 \u0636\u0645\u0627\u0646\u0627\u062A \u0627\u0644\u0645\u0644\u0643\u064A\u0629\u060C \u0648\u0636\u0645\u0627\u0646 \u0631\u0648\u0627\u062C \u0627\u0644\u0645\u0635\u0646\u0641 \u0641\u064A \u0627\u0644\u0633\u0648\u0642 \u0648\u0636\u0645\u0627\u0646 \u0645\u0644\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0635\u0646\u0641 \u0644\u063A\u0627\u064A\u0629 \u0645\u0639\u064A\u0646\u0629\u060C \u0648\u0636\u0645\u0627\u0646 \u0639\u062F\u0645 \u0627\u0644\u062A\u0639\u062F\u064A \u0623\u0648 \u063A\u064A\u0627\u0628 \u0627\u0644\u0639\u064A\u0628 \u0627\u0644\u062E\u0641\u064A \u0623\u0648 \u0639\u064A\u0648\u0628 \u0623\u062E\u0631\u0649 \u0623\u0648 \u0648\u062C\u0648\u062F \u0623\u0648 \u0639\u062F\u0645 \u0648\u062C\u0648\u062F \u0623\u062E\u0637\u0627\u0621 \u0641\u064A \u0627\u0644\u0645\u0635\u0646\u0641 \u0633\u0648\u0627\u0621 \u0643\u0627\u0646\u062A 