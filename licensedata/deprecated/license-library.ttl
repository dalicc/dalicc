	dalicc:WarrantyDisclaimer	"\u0540\u0561\u057E\u0561\u057D\u057F\u0561\u0563\u0580\u0565\u0580 \u0587 \u0565\u0580\u0561\u0577\u056D\u056B\u0584\u0576\u0565\u0580 \u053C\u056B\u0581\u0565\u0576\u0566\u0561\u057F\u0578\u0582\u0576 \u0570\u0561\u057E\u0561\u057D\u057F\u0578\u0582\u0574 \u0587 \u0565\u0580\u0561\u0577\u056D\u0561\u057E\u0578\u0580\u0578\u0582\u0574 \u0567, \u0578\u0580\u055D i.\t\u057D\u0578\u0582\u0575\u0576 \u053C\u056B\u0581\u0565\u0576\u0566\u056B\u0561\u0575\u056B \u056B\u0580\u0561\u056F\u0561\u0576\u0561\u0581\u0578\u0582\u0574\u0568 \u0587 \u056F\u0561\u057F\u0561\u0580\u0578\u0582\u0574\u0568 \u053C\u056B\u0581\u0565\u0576\u0566\u0561\u057F\u0578\u0582\u056B \u056C\u056B\u0561\u0566\u0578\u0580\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0576\u0565\u0580\u056B \u0574\u0565\u057B \u0565\u0576 \u0574\u057F\u0576\u0578\u0582\u0574 \u0587 \u0579\u0565\u0576 \u0570\u0561\u056F\u0561\u057D\u0578\u0582\u0574 \u0555\u0580\u0565\u0576\u0584\u056B\u0576. ii.\t\u053C\u056B\u0581\u0565\u0576\u0566\u0561\u057F\u0578\u0582\u0576 \u0561\u0574\u0562\u0578\u0572\u057B\u0578\u0582\u0569\u0575\u0561\u0574\u0562 \u057F\u056B\u0580\u0561\u057A\u0565\u057F\u0578\u0582\u0574 \u0567 \u056C\u056B\u0581\u0565\u0576\u0566\u0561\u057E\u0578\u0580\u057E\u0561\u056E \u054D\u057F\u0565\u0572\u056E\u0561\u0563\u0578\u0580\u056E\u0578\u0582\u0569\u0575\u0561\u0576 \u0576\u056F\u0561\u057F\u0574\u0561\u0574\u0562 \u057D\u0565\u0583\u0561\u056F\u0561\u0576\u0578\u0582\u0569\u0575\u0561\u0576 \u056B\u0580\u0561\u057E\u0578\u0582\u0576\u0584\u056B\u0576 \u0587, \u0578\u0580 \u056C\u056B\u0581\u0565\u0576\u0566\u0561\u057E\u0578\u0580\u0574\u0561\u0576 \u0563\u0578\u0580\u056E\u0568\u0576\u0569\u0561\u0581\u056B \u0561\u057C\u0576\u0579\u0578\u0582\u0569\u0575\u0561\u0574\u0562 \u053C\u056B\u0581\u0565\u0576\u0566\u0561\u057F\u0578\u0582\u056B \u0570\u0561\u0574\u0561\u0580 \u0578\u0580\u0587\u0567 \u056B\u0580\u0561\u057E\u0561\u056F\u0561\u0576 \u056D\u0578\u0579\u0568\u0576\u0564\u0578\u057F\u0576\u0565\u0580 \u0579\u056F\u0561\u0576.\n" ;
