	dalicc:LiabilityLimitation	"\u10DB\u10E3\u10EE.5 \u10D2\u10D0\u10D7\u10D5\u10D0\u10DA\u10D8\u10E1\u10EC\u10D8\u10DC\u10D4\u10D1\u10E3\u10DA\u10D8 \u10D2\u10D0\u10E0\u10D0\u10DC\u10E2\u10D8\u10D4\u10D1\u10D8\u10E1 \u10D2\u10D0\u10E0\u10D3\u10D0, \u10DA\u10D8\u10EA\u10D4\u10DC\u10D6\u10D8\u10D0\u10E0\u10D8 \u10DE\u10D0\u10E1\u10E3\u10EE\u10E1 \u10D0\u10D2\u10D4\u10D1\u10E1 \u10DB\u10EE\u10DD\u10DA\u10DD\u10D3 \u10D2\u10D0\u10DC\u10D6\u10E0\u10D0\u10EE \u10D0\u10DC \u10D2\u10D0\u10E3\u10E4\u10E0\u10D7\u10EE\u10D8\u10DA\u10D4\u10D1\u10DA\u10DD\u10D1\u10D8\u10D7 \u10DB\u10D8\u10E7\u10D4\u10DC\u10D4\u10D1\u10E3\u10DA\u10D8 \u10D6\u10D8\u10D0\u10DC\u10D8\u10E1\u10D0\u10D7\u10D5\u10D8\u10E1.\n" ;
