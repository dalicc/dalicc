	dalicc:LiabilityLimitation	"\u0628\u0627\u0633\u062A\u062B\u0646\u0627\u0621 \u0645\u0627 \u0647\u0648 \u0645\u0635\u0631\u062D \u0628\u0647 \u0628\u0645\u0648\u062C\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u0645\u0639\u0645\u0648\u0644 \u0628\u0647\u060C \u0644\u0627 \u064A\u0643\u0648\u0646 \u0627\u0644\u0645\u064F\u0631\u064E\u062E\u0650\u0651\u0635 \u0628\u0623\u064A \u062D\u0627\u0644 \u0645\u0646 \u0627\u0644\u0623\u062D\u0648\u0627\u0644 \u0645\u0633\u0626\u0648\u0644\u0627 \u062A\u062C\u0627\u0647 \u0627\u0644\u0645\u0631\u062E\u064E\u0651\u0635 \u0644\u0647 \u0648\u0641\u0642 \u0623\u064A \u0645\u0628\u062F\u0623 \u0642\u0627\u0646\u0648\u0646\u064A \u0639\u0646 \u0623\u064A \u0623\u0636\u0631\u0627\u0631 \u0637\u0627\u0631\u0626\u0629 \u0623\u0648 \u0645\u062A\u0631\u0627\u0628\u0637\u0629 \u0623\u0648 \u0639\u0642\u0627\u0628\u064A\u0629 \u0645\u0645\u0643\u0646 \u0623\u0646 \u062A\u0646\u062C\u0645 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u062A\u0631\u062E\u064A\u0635 \u0623\u0648 \u0639\u0646 \u0627\u0633\u062A\u0639\u0645\u0627\u0644 \u0627\u0644\u0645\u0635\u0646\u0641\u060C \u062D\u062A\u0649 \u0625\u0646 \u062A\u0645 \u0625\u0628\u0644\u0627\u063A \u0627\u0644\u0645\u064F\u0631\u064E\u062E\u0650\u0651\u0635 \u0628\u0627\u062D\u062A\u0645\u0627\u0644\u064A\u0629 \u062D\u062F\u0648\u062B \u0645\u062B\u0644 \u062A\u0644\u0643 \u0627\u0644\u0623\u0636\u0631\u0627\u0631.\n" ;
